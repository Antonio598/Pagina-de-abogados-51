# ============================================================================
# VERITUM — variables de entorno
# Copia este archivo como .env (local) o cárgalo en EasyPanel (Environment).
# Regla: si una variable pública está vacía, el bloque correspondiente NO se
# muestra en el sitio. Nunca publiques datos que VERITUM no haya confirmado.
# Las NEXT_PUBLIC_* se fijan en el build: en EasyPanel añádelas también como
# "Build arguments" (o reconstruye la imagen tras cambiarlas).
# ============================================================================

# --- Sitio ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://veritum.com.mx

# --- Datos de contacto (solo confirmados) -----------------------------------
NEXT_PUBLIC_TELEFONO=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_CORREO=
NEXT_PUBLIC_DOMICILIO=
NEXT_PUBLIC_HORARIO=
# Respuesta literal a la pregunta frecuente "¿Atienden en línea?" ({{modalidades}})
NEXT_PUBLIC_MODALIDADES=
# Todas las asesorías son por videollamada. Si algún día cambia, este texto es
# el que aparece en el sitio y en los correos.
NEXT_PUBLIC_MODALIDAD=En línea (videollamada)
NEXT_PUBLIC_REDES_LINKEDIN=
NEXT_PUBLIC_REDES_FACEBOOK=
NEXT_PUBLIC_REDES_INSTAGRAM=

# --- Formularios y agenda ---------------------------------------------------
# Plazo real de respuesta que se muestra al enviar (p. ej. "un día hábil").
# Vacío = el mensaje de confirmación no promete ningún tiempo.
NEXT_PUBLIC_PLAZO_RESPUESTA=
# Precio vigente de la asesoría inicial ({{precios}}). Vacío = no se muestra.
NEXT_PUBLIC_PRECIO_ASESORIA=
NEXT_PUBLIC_DURACION_ASESORIA=
NEXT_PUBLIC_POLITICA_CANCELACION=
# URL del proveedor de agenda autorizado ({{proveedor_agenda}}), cuenta a nombre de VERITUM.
# Vacío = la reserva se solicita por formulario y VERITUM confirma por correo.
NEXT_PUBLIC_AGENDA_URL=

# --- Correo (servidor) ------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Correo autorizado de VERITUM que recibe las solicitudes
CONTACT_TO_EMAIL=
# Versión del aviso de privacidad que se registra con cada consentimiento
PRIVACY_NOTICE_VERSION=

# --- Medición ---------------------------------------------------------------
# ID de Google Tag Manager (cuenta propiedad de VERITUM). Vacío = sin banner ni etiquetas.
NEXT_PUBLIC_GTM_ID=

# ============================================================================
# RESERVAS CON PAGO, LANDING DE CAMPAÑA Y PANEL INTERNO
# ============================================================================

# --- Base de datos (PostgreSQL / Supabase) ----------------------------------
# Conexión directa a Postgres (no la API REST). Es SECRETA: nunca NEXT_PUBLIC_.
#
# IMPORTANTE si la base de datos vive en el mismo servidor de EasyPanel:
# usa el nombre interno del servicio, no el dominio público. Así el tráfico
# no sale a internet y no viaja sin cifrar. Ejemplo:
#   postgresql://postgres:CLAVE@proyecto_supabase-db:5432/postgres?sslmode=disable
#
# Si tiene que salir a internet, usa sslmode=require (o no-verify si el
# certificado es autofirmado): los datos de los clientes viajan por ahí.
DATABASE_URL=
# Esquema propio, para compartir la base con otras aplicaciones.
DB_SCHEMA=veritum
# Tamaño del grupo de conexiones
DB_POOL_MAX=5

# --- Stripe -----------------------------------------------------------------
# Claves de la cuenta de VERITUM. El webhook debe apuntar a
#   https://<tu-dominio>/api/stripe/webhook
# con los eventos: checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Ids de precio creados en Stripe, uno por servicio. OPCIONALES: si se dejan
# vacíos, el importe se cobra con los precios de content/productos.ts, que es la
# fuente de verdad. Solo hacen falta si prefieres gestionar los precios en Stripe.
STRIPE_PRICE_ASESORIA_ID=
STRIPE_PRICE_REVISION_ID=

# --- Precios de los servicios ----------------------------------------------
# LOS IMPORTES NO SON VARIABLES DE ENTORNO. Viven en content/productos.ts
# ($1,990 la asesoría y $3,490 la revisión prioritaria), porque una NEXT_PUBLIC_
# vacía dejaba la landing sin precio y sin posibilidad de reservar, y el fallo no
# se notaba hasta que un cliente no podía pagar.
#
# Vigencia del crédito de representación, en días, desde el pago.
CREDITO_VIGENCIA_DIAS=90

# --- Agenda -----------------------------------------------------------------
BOOKING_TIMEZONE=America/Mexico_City
# Duración de cada sesión, en minutos. Los dos servicios son de hasta 60.
BOOKING_SLOT_MINUTES=60
# Minutos que se aparta el horario mientras la persona paga
BOOKING_HOLD_MINUTES=20
# Anticipación mínima para poder reservar (minutos)
BOOKING_LEAD_MINUTES=120
# Días hacia adelante que se ofrecen
BOOKING_HORIZON_DAYS=21

# --- Landing de campaña (/consulta) -----------------------------------------
# URL del agente de IA (WhatsApp, Messenger o web). Vacío = el botón no aparece.
NEXT_PUBLIC_AGENTE_IA_URL=
# Video MP4 subido a /public (p. ej. /video/veritum.mp4). Vacío = sin bloque de video.
NEXT_PUBLIC_LANDING_VIDEO=
NEXT_PUBLIC_LANDING_VIDEO_POSTER=

# --- Panel interno (/panel) --------------------------------------------------
PANEL_USER=
# Genera el hash con:  node scripts/hash-password.mjs "tu contraseña"
PANEL_PASSWORD_HASH=
# Cadena aleatoria larga (mínimo 32 caracteres) para firmar la sesión:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PANEL_SESSION_SECRET=

# ============================================================================
# SEGUIMIENTO AUTOMÁTICO CON n8n
# Documentación completa y ejemplos listos para pegar: /panel/api
# Todas son SECRETAS de servidor: ninguna NEXT_PUBLIC_, así que no hace falta
# reconstruir la imagen al cambiarlas, solo reiniciar el contenedor.
# ============================================================================

# Token que n8n manda en la cabecera:  Authorization: Bearer <token>
# Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vacío = las rutas /api/seguimientos/* responden 503.
SEGUIMIENTO_API_TOKEN=

# Webhook de n8n al que se mandan los recordatorios.
# Vacío = NO se manda nada (así un entorno de pruebas no dispara mensajes reales).
SEGUIMIENTO_WEBHOOK_URL=https://n8n-n8n.d3xtpr.easypanel.host/webhook/532af51d-efc7-4f2b-ae32-08eb90c2d148

# Opcional pero recomendado: se manda al webhook en la cabecera x-veritum-firma
# para que n8n pueda comprobar en un nodo IF que la llamada viene de este sitio.
# El webhook de n8n no pide autenticación por sí mismo.
SEGUIMIENTO_WEBHOOK_SECRET=

# Umbrales de inactividad en MINUTOS: 1 h, 3 h y 24 h.
SEGUIMIENTO_MIN_1=60
SEGUIMIENTO_MIN_2=180
SEGUIMIENTO_MIN_3=1440

# ============================================================================
# PORTAL DEL CLIENTE  (/portal)
# El cliente entra con su teléfono y el folio que recibió al pagar, y carga la
# documentación de su asunto. Los archivos se guardan en PostgreSQL.
# ============================================================================

# Firma de la sesión del portal. DEBE ser distinto de PANEL_SESSION_SECRET:
# un token del portal no debe poder verificarse como token del panel.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Vacío = el portal responde que no está disponible.
PORTAL_SESSION_SECRET=

# Sala fija de videollamada de VERITUM (Meet, Zoom…), como respaldo cuando una
# cita no tiene enlace propio asignado desde el panel.
# Vacío = el correo dice que el enlace se enviará antes de la sesión.
MEETING_URL=
